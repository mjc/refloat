{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "REFLOAT_BUILD_TESTS": "ON",
        "REFLOAT_STRICT_WARNINGS": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "Host Tests",
      "inherits": "host-base"
    },
    {
      "name": "package",
      "displayName": "Package Build",
      "inherits": "host-base",
      "cacheVariables": {
        "REFLOAT_BUILD_PACKAGE": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Host Coverage",
      "inherits": "host-base",
      "cacheVariables": {
        "REFLOAT_ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "package",
      "configurePreset": "package",
      "targets": [
        "refloat-package"
      ]
    },
    {
      "name": "package-lib",
      "configurePreset": "package",
      "targets": [
        "refloat-package-lib"
      ]
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "filter": {
        "include": {
          "label": "host"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "package",
      "configurePreset": "package",
      "filter": {
        "include": {
          "label": "package"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "host",
      "displayName": "Host Test Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "host"
        },
        {
          "type": "build",
          "name": "host"
        },
        {
          "type": "test",
          "name": "host"
        }
      ]
    },
    {
      "name": "package",
      "displayName": "Package Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "package"
        },
        {
          "type": "build",
          "name": "package"
        },
        {
          "type": "test",
          "name": "package"
        }
      ]
    },
    {
      "name": "package-lib",
      "displayName": "Package Lib Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "package"
        },
        {
          "type": "build",
          "name": "package-lib"
        }
      ]
    },
    {
      "name": "coverage",
      "displayName": "Coverage Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "test",
          "name": "coverage"
        }
      ]
    }
  ]
}
