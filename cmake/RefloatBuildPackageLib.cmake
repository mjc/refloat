if(NOT DEFINED REFLOAT_ARM_GCC_EXECUTABLE)
  message(FATAL_ERROR "REFLOAT_ARM_GCC_EXECUTABLE is required")
endif()

if(NOT DEFINED REFLOAT_ARM_OBJDUMP_EXECUTABLE)
  message(FATAL_ERROR "REFLOAT_ARM_OBJDUMP_EXECUTABLE is required")
endif()

if(NOT DEFINED REFLOAT_ARM_OBJCOPY_EXECUTABLE)
  message(FATAL_ERROR "REFLOAT_ARM_OBJCOPY_EXECUTABLE is required")
endif()

if(NOT DEFINED PYTHON_EXECUTABLE)
  message(FATAL_ERROR "PYTHON_EXECUTABLE is required")
endif()

if(NOT DEFINED REFLOAT_ROOT)
  message(FATAL_ERROR "REFLOAT_ROOT is required")
endif()

if(NOT DEFINED REFLOAT_PACKAGE_LIB_ELF)
  message(FATAL_ERROR "REFLOAT_PACKAGE_LIB_ELF is required")
endif()

if(NOT DEFINED REFLOAT_PACKAGE_LIB_BINARY)
  message(FATAL_ERROR "REFLOAT_PACKAGE_LIB_BINARY is required")
endif()

if(NOT DEFINED REFLOAT_PACKAGE_LIB_LIST)
  message(FATAL_ERROR "REFLOAT_PACKAGE_LIB_LIST is required")
endif()

if(NOT DEFINED REFLOAT_PACKAGE_LIB_LISP)
  message(FATAL_ERROR "REFLOAT_PACKAGE_LIB_LISP is required")
endif()

if(NOT DEFINED REFLOAT_PACKAGE_LIB_OBJECTS)
  message(FATAL_ERROR "REFLOAT_PACKAGE_LIB_OBJECTS is required")
endif()

if(NOT DEFINED REFLOAT_PACKAGE_LIB_LINK_OPTIONS)
  message(FATAL_ERROR "REFLOAT_PACKAGE_LIB_LINK_OPTIONS is required")
endif()

string(REPLACE "|" ";" REFLOAT_PACKAGE_LIB_OBJECTS "${REFLOAT_PACKAGE_LIB_OBJECTS}")
string(REPLACE "|" ";" REFLOAT_PACKAGE_LIB_LINK_OPTIONS "${REFLOAT_PACKAGE_LIB_LINK_OPTIONS}")

execute_process(
  COMMAND "${REFLOAT_ARM_GCC_EXECUTABLE}" ${REFLOAT_PACKAGE_LIB_OBJECTS} ${REFLOAT_PACKAGE_LIB_LINK_OPTIONS} -o "${REFLOAT_PACKAGE_LIB_ELF}"
  COMMAND_ERROR_IS_FATAL ANY
)

execute_process(
  COMMAND "${REFLOAT_ARM_OBJDUMP_EXECUTABLE}" -D "${REFLOAT_PACKAGE_LIB_ELF}"
  OUTPUT_FILE "${REFLOAT_PACKAGE_LIB_LIST}"
  COMMAND_ERROR_IS_FATAL ANY
)

execute_process(
  COMMAND "${REFLOAT_ARM_OBJCOPY_EXECUTABLE}" -O binary "${REFLOAT_PACKAGE_LIB_ELF}" "${REFLOAT_PACKAGE_LIB_BINARY}" --gap-fill 0x00
  COMMAND_ERROR_IS_FATAL ANY
)

execute_process(
  COMMAND "${PYTHON_EXECUTABLE}" "${REFLOAT_ROOT}/vesc_pkg_lib/conv.py" -f "${REFLOAT_PACKAGE_LIB_BINARY}" -n package_lib
  OUTPUT_FILE "${REFLOAT_PACKAGE_LIB_LISP}"
  COMMAND_ERROR_IS_FATAL ANY
)
