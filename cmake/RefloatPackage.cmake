    -DREFLOAT_PACKAGE_README_OUTPUT=${REFLOAT_PACKAGE_README_OUTPUT}
    -DREFLOAT_VERSION_FILE=${REFLOAT_ROOT}/version
    -DGIT_EXECUTABLE=${GIT_EXECUTABLE}
